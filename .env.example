# =============================================================================
# 逐日 Coding —— 环境变量清单（示例模板，可安全提交到仓库）
# -----------------------------------------------------------------------------
# ⚠️ 先读这条：本项目【不会自动加载 .env 文件】。
#
#   后端 Spring Boot 没有引入 dotenv，也没有 spring.config.import，
#   配置只有两个来源：
#     ① 操作系统环境变量（优先级更高）
#     ② 各模块 application*.yml 里写的 ${VAR:默认值}
#   （前端 Vite 虽然默认会读项目根的 .env，但 src/ 下没有任何 import.meta.env
#     引用，所以读了也是空转。）
#
#   因此本文件的作用是【配置清单 / 键位参考】，不是"复制成 .env 就能生效"。
#   真实注入方式任选其一：
#     · Windows 系统级：setx VAR "value"   或 系统属性 → 环境变量
#     · Linux / macOS / Git Bash：export VAR=value
#     · IDE：Run/Debug Configurations → Environment variables
#     · CI/CD：Secrets 注入
#
#   本文件不含任何真实密钥，全部为占位符。
#   来源：zhuri-coding 各模块 application*.yml 与 *.java 的实际引用，逐键核对。
# =============================================================================


# =============================================================================
# 一、【无默认值】缺失 → 服务启动直接失败
# =============================================================================

# JWT 签名密钥。网关 AppJwtUtil 会对其做 Base64 解码，所以必须是【合法 Base64】
# （32 字节 key ≈ 44 字符）。填普通短字符串会抛 Illegal base64 character 2d。
JWT_SECRET=

# 阿里云 OSS 访问密钥。content / user 的 OssClientConfig 在启动时强制创建 OSS 客户端，
# 缺失会抛 InvalidCredentialsException: Access key id should not be null or empty。
ALIBABA_RAM_ACCESS_KEY=
ALIBABA_RAM_ACCESS_SECRET=

# OAuth 第三方登录 client id（缺失只影响对应登录方式）
OAUTH_WEIBO_CLIENT_ID=
OAUTH_GITHUB_CLIENT_ID=


# =============================================================================
# 二、【空默认值 = 功能不可用 / fail-closed】生产环境必填
# =============================================================================

# 网关 → 内部服务 的签名密钥。网关与所有服务必须填【同一个值】；
# 留空或不一致 → fail-closed：所有需登录接口一律返回"未登录"。
# 本地开发约定值（见网关 application.yml 注释）：zhuri-coding-internal-dev-secret
INTERNAL_AUTH_SECRET=

# 支付宝沙箱（课程支付 / 打赏）。私钥/公钥填 PEM 去掉头尾后的纯 Base64，不要带换行。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 阿里云百炼（DashScope）大模型
DASH_SCOPE_API_KEY=
DASH_SCOPE_API_HOST=            # 例：https://dashscope.aliyuncs.com

# Elasticsearch 密码（无认证的本地实例可留空）
ES_PASSWORD=

# SEO 站点根地址（留空则不输出 sitemap 的绝对地址）
SEO_BASE_URL=

# 内网穿透 / 对外回调地址。
# ⚠️ 键名中的 "CPOlAR" 是仓库既有拼写（小写 L），看起来是 typo，
#    但 yml 就是这么引用的；若要改名必须同步改 yml，否则不生效。
# 用于：支付回调、打赏回跳、OAuth 回调
CPOlAR_BASE_URL=                # 网关对外地址，例：https://xxxx.r40.cpolar.top
CPOlAR_BASE_URL_WEB=            # 前端 SPA 对外地址
CPOlAR_BASE_URI=                # OAuth 回调路径，默认 /oauth/callback


# =============================================================================
# 三、【有可用默认值】本地开发通常无需改动
#     下方 = 后面的值即为 application*.yml 中的默认值，需要时再覆盖
# =============================================================================

# ---- MySQL ----
DB_USERNAME=root
DB_PASSWORD=123456

# ---- PostgreSQL + pgvector（内容向量检索 / 语义缓存）----
PGVECTOR_URL=jdbc:postgresql://192.168.44.128:5432/leadnews_content
PGVECTOR_USERNAME=postgres
PGVECTOR_PASSWORD=123456

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Nacos 配置中心 ----
NACOS_CONFIG_ADDR=127.0.0.1:8848
NACOS_CONFIG_DATA_IDS=zhuri-coding-content-dtp.yml

# ---- MinIO 对象存储 ----
MINIO_ENDPOINT=http://localhost:9005
MINIO_READ_PATH=http://localhost:9005
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=leadnews

# ---- RabbitMQ（当前 application.yml 中相关配置已注释，保留备用）----
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin

# ---- Elasticsearch（search 模块）----
ES_ARTICLE_INDEX=app_info_article

# ---- AI / 大模型 ----
# 注意：DASH_SCOPE_MODEL 在 content 模块内有两处引用且默认值不同
#（ChatClient 侧 qwen3.8-27b / 应用配置侧 qwen3.7-max），覆盖会同时影响两者。
DASH_SCOPE_MODEL=qwen3.7-max
DASH_SCOPE_VISION_MODEL=qwen3.8-27b
DASH_SCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASH_SCOPE_COMPATIBLE_BASE=https://llm-07pvgms9s4t42iko.cn-beijing.maas.aliyuncs.com/compatible-mode
AI_FLASH_MODEL=qwen3.8-flash
AI_ROUTER_CHAT_ENABLED=true

# AI 熔断：窗口 60s 内失败 5 次 → 熔断 30s
AI_CIRCUIT_WINDOW_SECONDS=60
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_SECONDS=30

# 单用户每日 AI 免费额度
AI_DAILY_FREE_REQUESTS=20
AI_DAILY_FREE_TOKENS=20000

# ---- 登录 / 跨域 ----
# true 仅供本地联调：无真实短信通道时验证码随响应体回传，前端会自动填充。
# 生产环境必须为 false，否则无需收短信即可登录 / 绑定他人手机号。
AUTH_EXPOSE_LOGIN_CODE=true
CORS_ALLOWED_ORIGINS=*

# ---- 微信公众号 ----
# 公众号后台"服务器配置"里填的 Token；未配置时回调一律拒绝（fail-closed）
WECHAT_GZH_TOKEN=huhudong
OAUTH_WECHAT_QRCODE_URL=mmexport1780758632985.jpeg

# ---- 网关限流 ----
GATEWAY_RL_IP_PER_MINUTE=600
GATEWAY_RL_SENSITIVE_PER_MINUTE=60

# ---- MyBatis 日志 ----
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl

# ---- 内容时效治理 / 文章更新通知 ----
ARTICLE_RECONCILE_INTERVAL_MS=3600000
ARTICLE_RECONCILE_INITIAL_DELAY_MS=60000
ARTICLE_RECONCILE_WINDOW_DAYS=3
ARTICLE_RECONCILE_SCAN_LIMIT=300
ARTICLE_RECONCILE_REPAIR_LIMIT=100
ARTICLE_UPDATE_NOTIFY_ENABLED=true
ARTICLE_UPDATE_NOTIFY_BATCH_SIZE=200
ARTICLE_UPDATE_NOTIFY_DEDUP_DAYS=7

# ---- 审核链路补偿任务 ----
AUDIT_RECOVERY_INTERVAL_MS=300000
AUDIT_RECOVERY_INITIAL_DELAY_MS=120000
AUDIT_RECOVERY_STALE_MINUTES=10
AUDIT_RECOVERY_BATCH=50
AUDIT_AUX_RETRY_ATTEMPTS=3
AUDIT_AUX_RETRY_BACKOFF_MS=1000

# ---- MCP 文件系统 Server（content 模块的 docs 检索）----
MCP_DOCS_PATH=../docs/public


# =============================================================================
# 四、【仅由 .java 中 System.getenv 读取】yml 里没有对应占位符
# =============================================================================

# OAuth 换取 token 用的 client secret（SocialAuthServiceImpl）
GITHUB_CLIENT_SECRET=
WEIBO_CLIENT_SECRET=

# AES 加密密钥（SimpleAesECBUtil；未设置时代码内兜底 "abc1234567890xyz"）
AES_SECRET_KEY=
