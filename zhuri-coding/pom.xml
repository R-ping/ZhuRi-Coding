<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.heima</groupId>
  <artifactId>heima-leadnews</artifactId>
  <packaging>pom</packaging>
  <version>1.0-SNAPSHOT</version>
  <modules>
    <module>heima-leadnews-common</module>
    <module>heima-leadnews-utils</module>
    <module>heima-leadnews-model</module>
    <module>heima-leadnews-feign-api</module>
    <module>heima-leadnews-service</module>
    <module>heima-leadnews-gateway</module>
    <module>heima-leadnews-basic</module>
  </modules>

  <!-- 继承Spring boot工程 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
  </parent>
  <properties>
    <!-- 项目源码及编译输出的编码 -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- 项目编译JDK版本 -->
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>

    <!-- 依赖包版本管理 -->
    <spring.boot.version>3.5.16</spring.boot.version>
    <lombok.version>1.18.32</lombok.version>
<!--    <mysql.version>5.1.46</mysql.version>-->
<!--    <mybatis.spring.version>2.0.1</mybatis.spring.version>-->
    <mybatis.plus.version>3.5.12</mybatis.plus.version>
    <lang3.version>3.17.0</lang3.version>
    <jsoup.version>1.17.2</jsoup.version>
    <fastjson.version>2.0.53</fastjson.version>
    <aliyun.oss.version>3.17.4</aliyun.oss.version>
    <spring.cloud.version>2025.0.3</spring.cloud.version>
    <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>
    <junit.version>4.12</junit.version>
    <ali.core.version>4.1.1</ali.core.version>
    <ali.green.version>3.4.1</ali.green.version>
    <minio.version>8.5.2</minio.version>
    <hutool.version>5.8.41</hutool.version>
  </properties>
  <dependencies>
    <!--日志处理包 - 使用logback + JSON格式输出，支持trace_id/span_id注入 -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>7.4</version>
    </dependency>
    <!-- 分布式链路追踪：Micrometer Tracing（Brave 桥接）+ Zipkin 上报，版本由 Boot BOM 管理。
         依赖注入后自动为 Servlet/WebFlux/Feign 生成 traceId/spanId 并写入 MDC，上报 Zipkin 聚合调用链 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-brave</artifactId>
    </dependency>
    <dependency>
      <groupId>io.zipkin.reporter2</groupId>
      <artifactId>zipkin-reporter-brave</artifactId>
    </dependency>
    <!-- 指标监控：Prometheus 注册表（Micrometer）。注册后暴露 /actuator/prometheus（需配合
         management.endpoints.web.exposure.include 开启端点），由 Prometheus 周期性抓取；
         同时自动收集 JVM/HTTP/Feign/Redis/DB 连接池等指标，版本由 Boot BOM 管理 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- MyBatis-Plus 3.5.9+ 拆分：IService/ServiceImpl 位于 mybatis-plus-extension，需显式引入 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-extension</artifactId>
    </dependency>
  </dependencies>

