<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.heima.content.mapper.user.UserScoreDetailsMapper">

    <resultMap id="BaseResultMap" type="com.heima.model.user.pojos.UserScoreDetails">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="category" property="category"/>
        <result column="action_code" property="actionCode"/>
        <result column="action_desc" property="actionDesc"/>
        <result column="score" property="score"/>
        <result column="biz_id" property="bizId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByCursor" resultMap="BaseResultMap">
        SELECT * FROM user_score_details
        WHERE user_id = #{userId}
        <if test="category != null and category > 0">
            AND category = #{category}
        </if>
        <if test="cursorCreatedAt != null and cursorId != null">
            AND (created_at &lt; #{cursorCreatedAt} OR (created_at = #{cursorCreatedAt} AND id &lt; #{cursorId}))
        </if>
        ORDER BY created_at DESC, id DESC
        LIMIT #{size}
    </select>
</mapper>